# Copy this file to .env and fill in real values. Never commit .env.

# Port the API (and, in production, the built frontend) listens on.
PORT=4000

# Shared secret required to read GET /api/enquiries (header: x-admin-key).
# Leave unset to keep that endpoint closed.
ADMIN_KEY=

# SMTP credentials used to email a notification for every new contact-form
# enquiry. All five of these must be set for email sending to activate —
# otherwise enquiries are still saved to server/data/enquiries.json, just
# without a notification. Any standard SMTP provider works (Gmail app
# password, Zoho, Outlook, SendGrid SMTP, etc.).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Optional: defaults to SMTP_USER if unset.
SMTP_FROM=

# Mailbox that should receive new-enquiry notifications.
NOTIFY_EMAIL=
